{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Wallpaper index read by the CleanTV Samsung host (kind wallpapers). Generated by tools/generate.py; scripts/validate.py also checks sizes, checksums, paths and the 262144-byte limit.",
  "type": "object",
  "required": [
    "api",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "api": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/definitions/entry"
      }
    }
  },
  "definitions": {
    "zone": {
      "enum": [
        "light",
        "mist",
        "dark"
      ]
    },
    "file": {
      "type": "object",
      "required": [
        "path",
        "size",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^cleantv-wallpapers/generated/aw-[a-z0-9]+(?:-[a-z0-9]+)*/(image|thumb|panel|study-soft|field-blur|field-frost|field-clear)\\.jpg$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "title",
        "rev",
        "tone",
        "ut",
        "frostVeil",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^aw-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "rev": {
          "type": "string",
          "pattern": "^[a-f0-9]{12}$"
        },
        "tone": {
          "enum": [
            "light",
            "dark"
          ]
        },
        "ut": {
          "type": "object",
          "required": [
            "tr",
            "br"
          ],
          "additionalProperties": false,
          "properties": {
            "tr": {
              "$ref": "#/definitions/zone"
            },
            "br": {
              "$ref": "#/definitions/zone"
            }
          }
        },
        "frostVeil": {
          "type": "number",
          "enum": [
            0.12,
            0.2,
            0.3,
            0.36,
            0.44
          ]
        },
        "listColumn": {
          "type": "integer",
          "enum": [
            0,
            2,
            3
          ]
        },
        "dockQuiet": {
          "type": "boolean"
        },
        "clockMist": {
          "type": "boolean"
        },
        "files": {
          "type": "object",
          "required": [
            "jpg",
            "thumb",
            "panel",
            "study-soft",
            "field-blur",
            "field-frost",
            "field-clear"
          ],
          "additionalProperties": false,
          "properties": {
            "jpg": {
              "$ref": "#/definitions/file"
            },
            "thumb": {
              "$ref": "#/definitions/file"
            },
            "panel": {
              "$ref": "#/definitions/file"
            },
            "study-soft": {
              "$ref": "#/definitions/file"
            },
            "field-blur": {
              "$ref": "#/definitions/file"
            },
            "field-frost": {
              "$ref": "#/definitions/file"
            },
            "field-clear": {
              "$ref": "#/definitions/file"
            }
          }
        }
      }
    }
  }
}
